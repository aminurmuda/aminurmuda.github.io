---
interface Props {
  item: {
    company: string;
    period: string;
    roles: {
      role: string;
      period: string;
      type: string;
      description: string;
      skills: string[];
    }[];
  };
  variant: 'mobile' | 'desktop-left' | 'desktop-right';
}

const { item, variant } = Astro.props;

const isMobile = variant === 'mobile';
const isLeft = variant === 'desktop-left';

const alignmentClass = isLeft ? "text-right" : "";
const skillContainerClasses = `flex flex-wrap gap-2 ${isLeft ? 'justify-end' : ''}`;
---

<div class={`bg-accent/5 border border-accent/10 p-4 md:p-6 rounded-2xl hover:border-accent/40 transition-all group ${alignmentClass}`}>
  <span class="font-mono text-xs tracking-widest uppercase text-accent/75">{item.period}</span>
  <h2 class="text-2xl font-heading font-bold text-accent mt-1 mb-6">{item.company}</h2>

  <div class="space-y-8">
    {item.roles.map((role, idx) => (
      <div class="relative">
        {idx > 0 && <div class="border-t border-accent/15 my-6"></div>}
        <span class="font-mono text-xs tracking-wide text-subtext/95">{role.period} • {role.type}</span>
        <h3 class="text-lg font-heading font-bold text-maintext mt-1.5 mb-2">{role.role}</h3>
        <p class="text-subtext font-body text-sm leading-relaxed mb-4 whitespace-pre-line">{role.description}</p>
        <div class={skillContainerClasses}>
          {role.skills.map((skill: string) => (
            <span class="rounded-md text-[10px] px-2 md:px-4 py-1 bg-accent/5 border border-accent/10 text-accent/80 group-hover:border-accent/40 group-hover:text-accent">
              {skill}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>
